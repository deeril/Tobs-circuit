PORT=3001
NODE_ENV=development
APP_BASE_URL=http://localhost:5173/Tobs-circuit/
DATA_DIRECTORY=./data

# Use a Neon PostgreSQL connection string for Vercel deployments.
DATABASE_URL=

# Frontend variables are included in the public browser bundle.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID

# Set these only when the frontend is hosted separately from the API.
VITE_API_BASE_URL=
FRONTEND_ORIGIN=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Tobs Route Circuit <no-reply@example.com>"
