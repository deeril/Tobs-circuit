PORT=3001
NODE_ENV=development
APP_BASE_URL=http://localhost:5173/Tobs-circuit/
DATA_DIRECTORY=./data

# Use a persistent PostgreSQL connection string in production (Render or Vercel).
DATABASE_URL=

# MapLibre uses a public OpenFreeMap style by default; override only if needed.
VITE_MAPLIBRE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Server-side providers. Use managed/self-hosted endpoints you control for production.
PHOTON_BASE_URL=
VALHALLA_BASE_URL=
VALHALLA_PROFILE=auto
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# Never use the application/production database for PostgreSQL integration tests.
# This dedicated disposable database is used to create/drop a random isolated schema.
DISPATCH_TEST_DATABASE_URL=

# Set these only when the frontend is hosted separately from the API.
VITE_API_BASE_URL=
VITE_SOCKET_URL=
FRONTEND_ORIGIN=

# Super Admin access is restricted in server.js to ayodeletobs@gmail.com.
# SMTP settings below are required to deliver the sign-in code to that address.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Tobs Route Circuit <no-reply@example.com>"
