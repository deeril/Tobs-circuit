{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/router.js": {
      "maxDuration": 30
    },
    "api/socket.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/router?__vercel_path=:path*"
    }
  ]
}
